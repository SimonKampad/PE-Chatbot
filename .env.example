# FitBuddy AI - Environment Variables Template
# Copy this file to .env and replace placeholder values with your real Gemini API key

# Google Gemini API key (Obtain free from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Port for the local Express server
PORT=3000
